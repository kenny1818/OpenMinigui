#ifdef __XHARBOUR__
  #define __MINIPRINT__
#else
  SET PROCEDURE TO alerts.prg
#endif

#include "hmg.ch"
#include "i_winuser.ch"

/*
   Author : Francisco Garcia Fernandez
   Objective : Simulate Clipper ALERT function

   Syntax : HMG_Alert( cText, [<aOptions>], [<cTitle>], [<nType>], [<cIcoName>], [<nIcoSize>], [<aBtnColors>], [<bInit>], [<lClosable>], [<cFontName>] )

   Last Modified by Grigory Filatov at 15-08-2026
*/

#define MARGIN 32
#define MARGIN_ICON 70
#define VMARGIN_BUTTON 4
#define HMARGIN_BUTTON 22
#define SEP_BUTTON 10
#define TAB Chr( 9 )

#define aBackColor     s_Config [1]
#define aFontColor     s_Config [2]
#define cLineSeparator s_Config [3]
#define nMaxLineLen    s_Config [4]
#define cFontNameAlert s_Config [5]

STATIC s_Config := { NIL, NIL, ";|", 79, "DlgFont" }

/*
 * Routine: HMG_Alert()
 *
 * Purpose:
 * Displays a modal alert dialog that simulates the Clipper ALERT function.
 * Renders a multi-line message, optional system or custom icon, and a set of
 * response buttons. Supports timeout-based auto-close when aOptions is numeric,
 * custom button colors via BUTTONEX, an optional init codeblock, and control
 * over the window close box / Escape key.
 *
 * Parameters:
 * cMsg - Character/USUAL - Message text. Converted via cValToChar(); lines may be
 *          delimited by the configured cLineSeparator (or TAB expanded to spaces).
 * aOptions - Array/Numeric - Array of button captions (default {"&OK"}). If numeric,
 *          treated as timeout seconds; a single OK button is shown and a timer
 *          closes the dialog automatically.
 * cTitle - Character - Window title (default _HMG_MESSAGE[10]).
 * nType - Numeric - System icon selector 1..4 (Warning/Question/Information/Error).
 *          Defaults to 1 when one button, 2 when two or more buttons.
 * cIcoFile - Character/Numeric - Custom icon file name, HICON handle, or SYSICO_*
 *          constant. Defaults to the system icon corresponding to nType.
 * nIcoSize - Numeric - Icon size in pixels (typically 32/48/64). Default 32.
 * aBtnColors - Array - Optional array of RGB color arrays, one per button; enables
 *          BUTTONEX with custom BACKCOLOR and NOXPSTYLE.
 * bInit - Block - Optional codeblock executed after the window is defined but before
 *          activation (via Do_WindowEventProcedure with 'WINDOW_INIT').
 * lClosable - Logical - When .T., the title-bar close box and Escape key are enabled
 *          and return 0. Default .F. (forced .T. when aOptions is empty/numeric).
 * cFontName - Character - Font name for labels and buttons (default cFontNameAlert).
 *          A temporary font is created from the system default if the named font
 *          does not yet exist.
 *
 * Returns:
 * Numeric - The Cargo value of the button that was pressed (1-based index stored
 *           in the button's Cargo). Returns 0 when the dialog is closed via the
 *           close box, Escape, or timeout without a button press. The same value
 *           is stored in the global _HMG_ModalDialogReturn.
 *
 * Side Effects:
 * Creates and activates a uniquely named modal window ("oDlg" or "oDlgN").
 * May define a temporary font and a one-shot timer.
 * Sets/clears the globals _HMG_PressButton and _HMG_ModalDialogReturn.
 * Draws an icon (DRAW ICON / DRAW SYSICON) and creates LABEL/EDITBOX plus
 * BUTTON or BUTTONEX controls. Releases the temporary font on exit when created.
 * Centres the dialog and optionally installs an ON KEY ESCAPE handler.
 */
FUNCTION HMG_Alert( cMsg, aOptions, cTitle, nType, cIcoFile, nIcoSize, aBtnColors, bInit, lClosable, cFontName )
   LOCAL nLineas
   LOCAL aIcon := { SYSICO_WARN, SYSICO_QUES, SYSICO_INFO, SYSICO_ERROR }
   LOCAL lFont := .F.
   LOCAL lEmpty := ( Empty( aOptions ) .OR. ISNUMERIC( aOptions ) )
   LOCAL cDelim, cOldDelim
   LOCAL cForm := "oDlg"
   LOCAL nMaxLen := 0
   LOCAL lOMHbak := _HMG_OwnerModalHandle

   IF _SetGetGlobal( "_HMG_IsWin10" ) == NIL
      STATIC _HMG_IsWin10 AS GLOBAL VALUE IsWin10OrLater()
   ENDIF

   STATIC _HMG_PressButton AS GLOBAL VALUE .F.

   _HMG_OwnerModalHandle := .T.

   IF _IsWindowDefined( cForm )
      nLineas := 0
      WHILE _IsWindowDefined( cForm := "oDlg" + hb_ntos( ++nLineas ) )
      END
   ENDIF

   hb_default( @aBackColor, nRGB2Arr( GetSysColor( COLOR_BTNFACE ) ) )
   hb_default( @aFontColor, nRGB2Arr( GetSysColor( COLOR_BTNTEXT ) ) )
   __defaultNIL( @cTitle, _HMG_MESSAGE [10] )
   __defaultNIL( @aOptions, { "&OK" } )
   hb_default( @lClosable, .F. )
   hb_default( @cFontName, cFontNameAlert )

   IF ISARRAY( aOptions )
      DEFAULT nType := iif( Len( aOptions ) > 1, 2, 1 )
   ELSE
      DEFAULT nType := 1
   ENDIF

#ifdef _HMG_COMPAT_
   CHECK TYPE cMsg AS USUAL, ;
      aOptions AS USUAL, ;
      cTitle AS CHARACTER, ;
      nType AS NUMERIC, ;
      cIcoFile AS USUAL, ;
      nIcoSize AS USUAL, ;
      aBtnColors AS USUAL, ;
      bInit AS USUAL, ;
      lClosable AS LOGICAL, ;
      cFontName AS CHARACTER
#endif
   IF nType < 1 .OR. nType > 4
      nType := 1
   ENDIF

   __defaultNIL( @cIcoFile, aIcon[ nType ] )
   hb_default( @nIcoSize, 32 )

   IF GetFontHandle( cFontName ) == 0
      lFont := .T.
      DEFINE FONT ( cFontName ) FONTNAME GetDefaultFontName() SIZE GetDefaultFontSize() - iif( _SetGetGlobal( "_HMG_IsWin10" ), 1, 0 )
   ENDIF

   cMsg := cValToChar( cMsg )

   IF Set( _SET_DELIMITERS ) .AND. ! Empty( cLineSeparator )
      cOldDelim := Set( _SET_DELIMCHARS )
      Set( _SET_DELIMCHARS, cLineSeparator )
#ifdef __XHARBOUR__
      cDelim := SubStr( Set( _SET_DELIMCHARS ), iif( Upper( Left( Set ( _SET_LANGUAGE ), 2 ) ) == "EL", 2, 1 ), 1 )
#else
      cDelim := SubStr( Set( _SET_DELIMCHARS ), iif( "el" $ hb_UserLang(), 2, 1 ), 1 )
#endif
      cMsg := StrTran( cMsg, cDelim, CRLF )
      Set( _SET_DELIMCHARS, cOldDelim )
   ENDIF

   nLineas := MLCount( cMsg )

   IF TAB $ cMsg
      cMsg := StrTran( cMsg, TAB, Space( 3 ) )
   ENDIF

   AEval( hb_ATokens( cMsg, CRLF ), {| ct | nMaxLen := Max( nMaxLen, Len( Trim( ct ) ) ) } )

   IF lEmpty
      lClosable := .T.
      _HMG_ModalDialogReturn := 0
   ELSE
      hb_default( @_HMG_ModalDialogReturn, 0 )
   ENDIF

   DEFINE WINDOW ( cForm ) ;
      WIDTH 0 HEIGHT 0 ;
      TITLE cTitle ;
      MODAL NOSIZE ;
      BACKCOLOR aBackColor ;
      ON INTERACTIVECLOSE ( _SetGetGlobal( "_HMG_PressButton" ) .OR. lClosable ) ;
      ON RELEASE iif( ! _SetGetGlobal( "_HMG_PressButton" ) .AND. lClosable, _HMG_ModalDialogReturn := 0, NIL )
#ifdef _OBJECT_
      This.Cargo := oHmgData()
#endif
      FillDlg( cMsg, aOptions, nLineas, cIcoFile, nIcoSize, aBtnColors, bInit, lClosable, cFontName, nMaxLen )
   END WINDOW

   ACTIVATE WINDOW ( cForm )

   IF lFont
      RELEASE FONT ( cFontName )
   ENDIF

   _HMG_OwnerModalHandle := lOMHbak

RETURN _HMG_ModalDialogReturn

/*
 * Routine: HMG_Alert_MaxLines()
 *
 * Purpose:
 * Sets or retrieves the maximum number of message lines that will be displayed
 * before the dialog switches from individual LABELs to a single READONLY EDITBOX.
 * Optionally also sets the maximum line length used by MemoLine().
 *
 * Parameters:
 * nLines - Numeric - New maximum line count (must be > 0). When omitted the
 *          current value is left unchanged.
 * nWide - Numeric - New maximum line length for MemoLine() (must be > 0 and < 255).
 *         When omitted the current nMaxLineLen is left unchanged.
 *
 * Returns:
 * Numeric - The previous maximum-line value that was stored in the global.
 *
 * Side Effects:
 * Updates the global named "_" + ProcName() via _AddNewGlobal / _SetGetGlobal.
 * May assign the module-level nMaxLineLen (via the #define alias).
 */
FUNCTION HMG_Alert_MaxLines( nLines, nWide )
   LOCAL cVarName := "_" + ProcName()
   LOCAL nOldLines := _AddNewGlobal( cVarName, 28 )

   IF HB_ISNUMERIC( nLines ) .AND. nLines > 0
      _SetGetGlobal( cVarName, nLines )
   ENDIF

   IF HB_ISNUMERIC( nWide ) .AND. nWide > 0 .AND. nWide < 255
      nMaxLineLen := nWide
   ENDIF

RETURN nOldLines

/*
 * Routine: HMG_Alert_RowStart()
 *
 * Purpose:
 * Sets or retrieves the vertical starting offset (in character-height units)
 * used for the first label / editbox inside the alert dialog.
 *
 * Parameters:
 * nRow - Numeric - New starting row (>= 0). When omitted the current value is
 *        left unchanged.
 *
 * Returns:
 * Numeric - The previous starting-row value stored in the global.
 *
 * Side Effects:
 * Updates the global named "_" + ProcName() via _AddNewGlobal / _SetGetGlobal.
 */
FUNCTION HMG_Alert_RowStart( nRow )
   LOCAL cVarName := "_" + ProcName()
   LOCAL nOldRow := _AddNewGlobal( cVarName, 0 )

   IF HB_ISNUMERIC( nRow ) .AND. nRow >= 0
      _SetGetGlobal( cVarName, nRow )
   ENDIF

RETURN nOldRow

/*
 * Routine: HMG_Alert_FontName()
 *
 * Purpose:
 * Sets or retrieves the default font name used by subsequent HMG_Alert() calls
 * when the caller does not supply an explicit cFontName argument.
 *
 * Parameters:
 * cFontName - Character - New font name. When omitted the current value is left
 *             unchanged.
 *
 * Returns:
 * Character - The previous font name that was stored in cFontNameAlert.
 *
 * Side Effects:
 * Assigns the module-level cFontNameAlert (via the #define alias of s_Config[5]).
 */
FUNCTION HMG_Alert_FontName( cFontName )
   LOCAL cOldFont := cFontNameAlert

   IF HB_ISCHAR( cFontName )
      cFontNameAlert := cFontName
   ENDIF

RETURN cOldFont

/*
 * Routine: HMG_Alert_Separator()
 *
 * Purpose:
 * Sets or retrieves the character sequence used to split the alert message into
 * multiple lines when the _SET_DELIMITERS flag is active.
 *
 * Parameters:
 * cSeparator - Character - New separator string. When omitted the current value
 *              is left unchanged.
 *
 * Returns:
 * Character - The previous separator that was stored in cLineSeparator.
 *
 * Side Effects:
 * Assigns the module-level cLineSeparator (via the #define alias of s_Config[3]).
 */
FUNCTION HMG_Alert_Separator( cSeparator )
   LOCAL cOldSep := cLineSeparator

   IF HB_ISCHAR( cSeparator )
      cLineSeparator := cSeparator
   ENDIF

RETURN cOldSep

/*
 * Routine: FillDlg()
 *
 * Purpose:
 * Populates an already-defined HMG_Alert modal window with the message text,
 * optional icon, and response buttons. Calculates dialog and control metrics
 * from font measurements, desktop size and the supplied parameters, then creates
 * the necessary LABEL/EDITBOX, BUTTON/BUTTONEX and (when required) TIMER controls.
 *
 * Parameters:
 * cMsg - Character - Fully prepared multi-line message text.
 * aOptions - Array/Numeric - Button captions or timeout seconds (already normalised
 *            by the caller when numeric).
 * nLineas - Numeric - Number of lines present in cMsg (from MLCount).
 * cIcoFile - Character/Numeric - Icon source (file, HICON or SYSICO_* constant).
 * nIcoSize - Numeric - Requested icon size in pixels; 0 suppresses the icon.
 * aBtnColors - Array - Optional per-button RGB color arrays; presence enables
 *              BUTTONEX with custom colours.
 * bBlock - Block - Optional WINDOW_INIT codeblock to execute after controls are
 *          created.
 * lClosable - Logical - Controls whether Escape is bound and whether the window
 *             may be closed without a button press.
 * cFont - Character - Font name already resolved by the caller.
 * nMaxLen - Numeric - Longest trimmed line length (used for width calculations).
 *
 * Returns:
 * NIL
 *
 * Side Effects:
 * Creates LABEL or EDITBOX controls for the message, BUTTON or BUTTONEX controls
 * for each option, and optionally a TIMER. Draws an icon via DRAW ICON / DRAW
 * SYSICON. Sets This.Width / This.Height / This.Closable, centres the window,
 * sets initial focus, and may install an ON KEY ESCAPE handler. When a timeout
 * was requested the timer is enabled just before return. Stores control type
 * information in This.Cargo when compiled with _OBJECT_.
 */
STATIC FUNCTION FillDlg( cMsg, aOptions, nLineas, cIcoFile, nIcoSize, aBtnColors, bBlock, lClosable, cFont, nMaxLen )
   LOCAL hWnd
   LOCAL hDC
   LOCAL hDlgFont
   LOCAL aBut := {}
   LOCAL cForm := ThisWindow.Name
   LOCAL cLblName
   LOCAL cBtnName
   LOCAL nRow := HMG_Alert_RowStart()
   LOCAL nCol := MARGIN * 0.6
   LOCAL nOpc := 1
   LOCAL nMaxLin := 0
   LOCAL nMaxBoton := 0
   LOCAL nMaxLines := HMG_Alert_MaxLines()
   LOCAL nMaxHeight
   LOCAL nMaxWidth
   LOCAL nLenBotones
   LOCAL nLenaOp
   LOCAL nWidthCli, nHeightCli
   LOCAL nWidthDlg, nHeightDlg
   LOCAL nChrHeight
   LOCAL nHeightBtn
   LOCAL nVMARGIN_BUTTON := VMARGIN_BUTTON
   LOCAL nSeconds
   LOCAL n
   LOCAL lIsWin10 := _SetGetGlobal( "_HMG_IsWin10" )
   LOCAL lExt
#ifdef _OBJECT_
   LOCAL nY, nX, cIco
#endif

#ifdef _HMG_COMPAT_
   CHECK TYPE cMsg AS CHARACTER, ;
      aOptions AS USUAL, ;
      nLineas AS NUMERIC, ;
      cIcoFile AS USUAL, ;
      nIcoSize AS NUMERIC, ;
      aBtnColors AS USUAL, ;
      bBlock AS USUAL, ;
      lClosable AS LOGICAL, ;
      cFont AS CHARACTER, ;
      nMaxLen AS NUMERIC
#endif
   IF ISNUMERIC( aOptions )
      nSeconds := aOptions
      aOptions := { "&OK" }
      DEFINE TIMER oTimer OF ( cForm ) INTERVAL nSeconds * 1000 ACTION ( _SetGetGlobal( "_HMG_PressButton", .T. ), ThisWindow.Release() )
#ifdef _OBJECT_
      This.Cargo:oTimer := "TIMER"
#endif
      This.oTimer.Enabled := .F.
   ENDIF

   nLenaOp := iif( ISARRAY( aOptions ), Len( aOptions ), 1 )

   IF ( lExt := ( ISARRAY( aBtnColors ) .AND. Len( aBtnColors ) == nLenaOp ) )
      nVMARGIN_BUTTON := 3 * VMARGIN_BUTTON
   ENDIF
   hDlgFont := GetFontHandle( cFont )

   // Column offset for the message area; leave space for the icon when present.
   IF nIcoSize > 0
      nCol := MARGIN_ICON + iif( nIcoSize == 32, 0, MARGIN_ICON / iif( nIcoSize == 64, 2.8, 3.2 ) )
   ENDIF

   hWnd := This.Handle
   hDC := GetDC( hWnd )

   // Character height of the dialog font (includes vertical button margin).
   nChrHeight := GetTextHeight( hDC, aOptions[ 1 ], hDlgFont ) + nVMARGIN_BUTTON / 2

   // Nominal maximum text width derived from the longest line length.
   nMaxWidth := GetFontWidth( cFont, nMaxLen )
   IF GetTextWidth( hDC, Space( 10 ), hDlgFont ) != GetTextWidth( hDC, Replicate( "B", 10 ), hDlgFont )
      nMaxWidth *= 0.7
   ENDIF

   FOR n := 1 TO nLineas
      nMaxLin := Max( nMaxLin, GetTextWidth( hDC, AllTrim( MemoLine( cMsg, nMaxLineLen, n ) ), hDlgFont ) )
   NEXT

   // Widest button caption determines individual button width.
   FOR n := 1 TO nLenaOp
      nMaxBoton := Max( nMaxBoton, GetTextWidth( hDC, aOptions[ n ], hDlgFont ) )
   NEXT

   ReleaseDC( hWnd, hDC )

   nMaxBoton += ( HMARGIN_BUTTON * iif( ! lExt .AND. lIsWin10 .AND. nLenAop > 2, 1.1, iif( nLenAop > 1, 2, 3 ) ) )

   // Total width occupied by all buttons plus inter-button gaps.
   nLenBotones := ( nMaxBoton + SEP_BUTTON ) * nLenaOp

   nHeightBtn := nVMARGIN_BUTTON + nChrHeight + nVMARGIN_BUTTON

   // Client width is the larger of the text block or the button row.
   IF nMaxWidth > nMaxLin
      nMaxLin := nMaxWidth
   ENDIF

   nWidthCli := Max( MARGIN_ICON + nMaxLin + MARGIN, MARGIN + nLenBotones + MARGIN - HMARGIN_BUTTON ) + iif( nIcoSize > 48, MARGIN / 4, 0 )
   nWidthDlg := nWidthCli + GetBorderWidth() + iif( nLineas > nMaxLines + 5, MARGIN * 1.5, 0 )

   IF nWidthDlg > GetDesktopRealWidth()
      nMaxWidth := nWidthDlg - GetDesktopRealWidth()
      nWidthDlg := GetDesktopRealWidth()
   ELSE
      nMaxWidth := 0
   ENDIF

   nHeightCli := ( Min( nMaxLines, nLineas ) + iif( nLineas == 1, 4, 3 ) ) * nChrHeight + nVMARGIN_BUTTON + nHeightBtn + GetBorderHeight()
   nHeightDlg := nHeightCli + GetTitleHeight() + SEP_BUTTON + GetBorderHeight() / iif( lIsWin10, 2.5, 1 )

   IF _HMG_IsBcc77OrLater .AND. _HMG_IsThemed
      nWidthDlg += GetBorderWidth() + 2
      nHeightDlg += GetBorderHeight() + 2
   ENDIF

   IF nHeightDlg > GetDesktopRealHeight()
      n := 0
      WHILE ( nHeightDlg - ( nChrHeight * ( ++n ) ) ) > GetDesktopRealHeight()
      END
      nMaxHeight := nChrHeight * n
      nMaxLines -= n
      nHeightDlg -= nMaxHeight
      nHeightCli -= nMaxHeight
   ENDIF

   This.Width := nWidthDlg
   This.Height := nHeightDlg

   IF Empty( nRow )
      nRow := nChrHeight
   ENDIF

   IF nLineas > 1

      IF nLineas > nMaxLines

         cLblName := "Say_01"

         @ nRow + GetBorderHeight(), nCol EDITBOX ( cLblName ) VALUE AllTrim( cMsg ) OF ( cForm ) ;
            FONT cFont WIDTH nWidthCli - nCol - GetBorderWidth() - MARGIN / 4 - nMaxWidth ;
            HEIGHT nChrHeight * nMaxLines - iif( nLineas > nMaxLines + 5, MARGIN / 2, 0 ) - GetBorderHeight() ;
            FONTCOLOR aFontColor BACKCOLOR aBackColor READONLY NOHSCROLL
#ifdef _OBJECT_
         This.Cargo:Set( cLblName, This.(cLblName).Type )
#endif
      ELSE

         FOR n := 1 TO nLineas

            cLblName := "Say_" + StrZero( n, 2 )

            @ nRow * ( n + iif( nLineas == 1, .5, 0 ) ) + GetBorderHeight(), nCol ;
               LABEL ( cLblName ) VALUE AllTrim( MemoLine( cMsg, nMaxLineLen, n ) ) OF ( cForm ) ;
               FONT cFont WIDTH nWidthCli - nCol - GetBorderWidth() - MARGIN / 4 - nMaxWidth ;
               HEIGHT nChrHeight ;
               FONTCOLOR aFontColor BACKCOLOR aBackColor VCENTERALIGN
#ifdef _OBJECT_
            This.Cargo:Set( cLblName, This.(cLblName).Type )
#endif
         NEXT n

      ENDIF

   ELSE

      cLblName := "Say_01"

      @ nRow + GetBorderHeight(), nCol LABEL ( cLblName ) VALUE AllTrim( cMsg ) OF ( cForm ) ;
         FONT cFont WIDTH nWidthCli - nCol - GetBorderWidth() - MARGIN / 4 HEIGHT Max( nChrHeight, nIcoSize ) ;
         FONTCOLOR aFontColor BACKCOLOR aBackColor VCENTERALIGN
#ifdef _OBJECT_
      This.Cargo:Set( cLblName, This.(cLblName).Type )
#endif
   ENDIF

   IF nIcoSize > 0

#ifdef _OBJECT_
      nY := nRow + GetBorderHeight()
      cIco := "ICON"
#endif
      IF ISNUMBER( cIcoFile )

         IF IsHIcon( cIcoFile )
#ifdef _OBJECT_
            nX := MARGIN / iif( nIcoSize == 32, 1.4, iif( nIcoSize == 48, 1.7, 2 ) )
#endif
            DRAW ICON IN WINDOW ( cForm ) ;
               AT nRow + GetBorderHeight(), MARGIN / iif( nIcoSize == 32, 1.4, iif( nIcoSize == 48, 1.7, 2 ) ) ;
               HICON cIcoFile WIDTH nIcoSize HEIGHT nIcoSize TRANSPARENT
         ELSE
#ifdef _OBJECT_
            nX := MARGIN / 1.4
            cIco := "SYSICON " + hb_ntos( cIcoFile )
#endif
            DRAW SYSICON IN WINDOW ( cForm ) ;
               AT nRow + GetBorderHeight(), MARGIN / 1.4 ;
               ICON cIcoFile WIDTH nIcoSize HEIGHT nIcoSize TRANSPARENT
         ENDIF
      ELSE
#ifdef _OBJECT_
         nX := MARGIN / iif( nIcoSize == 32, 1.4, iif( nIcoSize == 48, 1.7, 2 ) )
#endif
         DRAW ICON IN WINDOW ( cForm ) ;
            AT nRow + GetBorderHeight(), MARGIN / iif( nIcoSize == 32, 1.4, iif( nIcoSize == 48, 1.7, 2 ) ) ;
            PICTURE cIcoFile WIDTH nIcoSize HEIGHT nIcoSize TRANSPARENT

      ENDIF

#ifdef _OBJECT_
      This.Cargo:Draw := { cIco, nY, nX, cIcoFile, nIcoSize }
#endif
   ENDIF

#ifdef _OBJECT_
   This.Cargo:lExtButton := lExt
#endif
   FOR n := 1 TO nLenaOp

      cBtnName := "Btn_" + StrZero( n, 2 )

      AAdd( aBut, cBtnName )

      IF lExt

         @ 0, 0 BUTTONEX ( cBtnName ) OF ( cForm ) CAPTION aOptions[ n ] ;
            FONTCOLOR hb_defaultValue( _HMG_aButtonFontColor, aFontColor ) BACKCOLOR aBtnColors[ n ] NOXPSTYLE HANDCURSOR ;
            FONT cFont WIDTH nMaxBoton HEIGHT nVMARGIN_BUTTON + nChrHeight + nVMARGIN_BUTTON ;
            ACTION ( _HMG_ModalDialogReturn := This.Cargo, _SetGetGlobal( "_HMG_PressButton", .T. ), ThisWindow.Release() )
#ifdef _OBJECT_
         This.Cargo:Set( cBtnName, This.(cBtnName).Type )
#endif
      ELSE

         @ 0, 0 BUTTON ( cBtnName ) OF ( cForm ) CAPTION aOptions[ n ] ;
            FONT cFont WIDTH nMaxBoton HEIGHT nVMARGIN_BUTTON + nChrHeight + nVMARGIN_BUTTON ;
            ACTION ( _HMG_ModalDialogReturn := This.Cargo, _SetGetGlobal( "_HMG_PressButton", .T. ), ThisWindow.Release() )
#ifdef _OBJECT_
         This.Cargo:Set( cBtnName, This.(cBtnName).Type )
#endif
      ENDIF

      This.( aBut[ nOpc ] ).Cargo := nOpc++

   NEXT n

   nOpc := 1

   FOR n := nLenaOp TO 1 STEP -1
      This.( aBut[ n ] ).Row := nHeightCli + SEP_BUTTON + GetBorderHeight() / iif( lIsWin10, 2.5, .9 ) - nChrHeight - nHeightBtn
      This.( aBut[ n ] ).Col := nWidthCli - nMaxWidth + iif( lIsWin10, 0, GetBorderWidth() / 2 ) - ( nMaxBoton + SEP_BUTTON ) * nOpc++
   NEXT n

   This.Closable := lClosable

   This.( aBut[ Max( 1, Min( nLenaOp, _HMG_ModalDialogReturn ) ) ] ).SetFocus()

   This.Center()

   IF lClosable
      ON KEY ESCAPE OF ( cForm ) ACTION ( _HMG_ModalDialogReturn := 0, _SetGetGlobal( "_HMG_PressButton", .T. ), ThisWindow.Release() )
   ENDIF

   IF HB_ISBLOCK( bBlock )
      Do_WindowEventProcedure( bBlock, This.Index, 'WINDOW_INIT' )
   ENDIF

   IF _IsControlDefined( "oTimer", cForm )
      This.oTimer.Enabled := .T.
   ENDIF

RETURN NIL

/*
 * Routine: _SetMsgAlertColors()
 *
 * Purpose:
 * Sets the default background and/or font colours used by subsequent HMG_Alert()
 * dialogs. Colours are stored in the module-level s_Config array.
 *
 * Parameters:
 * aBackClr - Array - New background colour (RGB array). When NIL the existing
 *            background colour is left unchanged.
 * aFontClr - Array - New font colour (RGB array). When NIL the existing font
 *            colour is left unchanged.
 *
 * Returns:
 * Array - Two-element array containing the previous background and font colours
 *         { aBackColor, aFontColor }.
 *
 * Side Effects:
 * Assigns aBackColor and/or aFontColor (aliases of s_Config[1] and s_Config[2]).
 */
FUNCTION _SetMsgAlertColors( aBackClr, aFontClr )
   LOCAL aOldClrs := { aBackColor, aFontColor }

   IF aBackClr != NIL
      aBackColor := aBackClr
   ENDIF

   IF aFontClr != NIL
      aFontColor := aFontClr
   ENDIF

RETURN aOldClrs

#ifdef _HMG_COMPAT_
/*
 * Routine: HMG_CheckType()
 *
 * Purpose:
 * Runtime type-checking helper used by the CHECK TYPE macro under _HMG_COMPAT_.
 * Validates each supplied parameter specification against the actual ValType of
 * the corresponding argument and raises MsgMiniGuiError on mismatch.
 *
 * Parameters:
 * lSoft - Logical - (Harbour builds only) When .T., a NIL value ("U") is accepted
 *         even when a concrete type was declared. In xHarbour builds the first
 *         element of the vararg list is treated as this flag.
 * ... - Variable - Zero or more three-element arrays of the form
 *       { cTypeDef, cValType, cVarName } describing the expected type, the
 *       observed ValType character, and the parameter name for the error message.
 *
 * Side Effects:
 * May terminate the application via MsgMiniGuiError when a type mismatch is detected.
 * In xHarbour builds the first element of the parameter array is removed after
 * it has been interpreted as lSoft.
 */
#ifndef __XHARBOUR__
PROCEDURE HMG_CheckType( lSoft, ... )
#else
PROCEDURE HMG_CheckType( ... )
#endif
   LOCAL i, j

   // aData := { cTypeDef, cValType, cVarName }
   LOCAL aData

   // aType := { cTypeDef, cValType }
   LOCAL aType := { ;
      { "ARRAY", "A" }, ;
      { "BLOCK", "B" }, ;
      { "CHARACTER", "C" }, ;
      { "DATE", "D" }, ;
      { "HASH", "H" }, ;
      { "LOGICAL", "L" }, ;
      { "NIL", "U" }, ;
      { "NUMERIC", "N" }, ;
      { "MEMO", "M" }, ;
      { "POINTER", "P" }, ;
      { "SYMBOL", "S" }, ;
      { "TIMESTAMP", "T" }, ;
      { "OBJECT", "O" }, ;
      { "USUAL", "" } }
   LOCAL aParams := hb_AParams()
#ifdef __XHARBOUR__
   LOCAL lSoft

   lSoft := aParams[ 1 ]
#endif
   hb_ADel( aParams, 1, .T. ) // Remove lSoft parameter from the array

   FOR EACH aData IN aParams

      IF Upper( AllTrim( aData[ 1 ] ) ) <> "USUAL"

         IF !( lSoft .AND. AllTrim( aData[ 2 ] ) == "U" )

            i := AScan( aType, {| x | x[ 1 ] == Upper( AllTrim( aData[ 1 ] ) ) } )

            IF i == 0 .OR. aType[ i ][ 2 ] <> aData[ 2 ]

               j := AScan( aType, {| x | x[ 2 ] == aData[ 2 ] } )

               MsgMiniGuiError( "CHECK TYPE ( Param # " + hb_ntos( aData:__enumindex() ) + " ) : " + AllTrim( aData[ 3 ] ) + " is declared as " + Upper( AllTrim( aData[ 1 ] ) ) + " but it have type " + aType[ j ][ 1 ] + "." )

            ENDIF

         ENDIF

      ENDIF

   NEXT

RETURN

#endif

*=============================================================================*
* Auxiliary Functions
*=============================================================================*

/*
 * Routine: GetDesktopRealWidth()
 *
 * Purpose:
 * Returns the width of the usable desktop work area (screen area excluding the
 * taskbar and other docked bars) in pixels.
 *
 * Parameters:
 * (none)
 *
 * Returns:
 * Numeric - Right edge minus left edge of the rectangle returned by GetDesktopArea().
 *
 * Side Effects:
 * None.
 */
FUNCTION GetDesktopRealWidth()

   LOCAL a := GetDesktopArea()

RETURN ( a[ 3 ] - a[ 1 ] )

/*
 * Routine: GetDesktopRealHeight()
 *
 * Purpose:
 * Returns the height of the usable desktop work area (screen area excluding the
 * taskbar and other docked bars) in pixels.
 *
 * Parameters:
 * (none)
 *
 * Returns:
 * Numeric - Bottom edge minus top edge of the rectangle returned by GetDesktopArea().
 *
 * Side Effects:
 * None.
 */
FUNCTION GetDesktopRealHeight()

   LOCAL a := GetDesktopArea()

RETURN ( a[ 4 ] - a[ 2 ] )

#ifdef __XHARBOUR__
#include "alerts.prg"
#endif
